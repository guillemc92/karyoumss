# El único puerto publicado del stack (DD-OPS-001 D4). La misma tabla que
# Caddyfile.dev, pero con los frontends ya compilados y los servicios por su
# nombre en la red del compose.
{
	admin off
	auto_https off
}

:8080 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/clinic/* {
		reverse_proxy clinic:8000
	}
	handle /api/admin/* {
		reverse_proxy admin:8000
	}
	handle /api/auth/* {
		reverse_proxy admin:8000
	}
	redir /clinic /clinic/
	handle_path /clinic/* {
		root * /srv/clinic
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
