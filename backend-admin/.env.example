# backend-admin — environment variables (NO commitear .env real)
# Copiar a .env y rellenar valores reales.

# Django
DJANGO_SECRET_KEY=<django-secret-key-min-50-chars>
DJANGO_DEBUG=True                          # False en producción
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (mismo cluster que backend-clinical, schema distinto)
# El rol de la DB debe tener GRANT solo sobre schema 'admin', NO sobre 'public' ni clinical.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biomed
POSTGRES_USER=biomed_admin_service
POSTGRES_PASSWORD=<placeholder>

# Auth bridge (F0) — MISMO secret que backend-clinical
AUTH_BRIDGE_SECRET=<64+ chars random hex>
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"

# Login unificado (ADR-0017) — secret PROPIO, independiente de AUTH_BRIDGE_SECRET
# y de AUTH_CLINIC_SECRET (backend-clinic). NUNCA reusar el mismo valor.
AUTH_ADMIN_JWT_SECRET=<64+ chars random hex, distinto de AUTH_BRIDGE_SECRET>
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"

# 2FA (P2, ADR-0014, DD-ADMIN-002 §3.2) — cifra two_factor_secret at-rest
# con Fernet (reversible, requerido por TOTP — un hash irreversible no
# sirve porque el servidor necesita el secret en claro para verificar).
TOTP_VAULT_KEY=<Fernet key>
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# CORS (F4)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
ADMIN_API_RATE_LIMIT=60/min