# backend-admin — environment variables (NO commitear .env real)
# Copiar a .env y rellenar valores reales.

# Django
DJANGO_SECRET_KEY=<django-secret-key-min-50-chars>
DJANGO_DEBUG=True                          # False en producción
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (mismo cluster que backend-clinical, schema distinto)
# El rol de la DB debe tener GRANT solo sobre schema 'admin', NO sobre 'public' ni clinical.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biomed
POSTGRES_USER=biomed_admin_service
POSTGRES_PASSWORD=<placeholder>

# Auth bridge (F0) — MISMO secret que backend-clinical
AUTH_BRIDGE_SECRET=<64+ chars random hex>
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"

# CORS (F4)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
ADMIN_API_RATE_LIMIT=60/min