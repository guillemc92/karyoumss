# frontend-admin — env vars (NO commitear .env real)
# Copiar a .env y rellenar.

# Backend admin (Django REST API)
VITE_ADMIN_API_BASE=http://localhost:8001
# Si está detrás de reverse proxy Caddy en prod: VITE_ADMIN_API_BASE=/api/admin

# Auth bridge (FastAPI exchange)
VITE_FASTAPI_LOGIN_URL=http://localhost:8000/api/v1/auth/login

# Logging
VITE_LOG_LEVEL=info