DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SSO (ADR-0020): debe ser IDÉNTICO a AUTH_ADMIN_JWT_SECRET en backend-admin/.env
AUTH_ADMIN_JWT_SECRET=change-me-same-value-as-backend-admin-env
CLINIC_FASTAPI_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000
CLINIC_DB_NAME=clinic_demo.sqlite3
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATIENT_VAULT_KEY=change-me-generate-a-fernet-key

# --- LLM local para la narrativa del informe (ADR-0024) ---
# Ollama en localhost: NO requiere API key, y ningun dato clinico sale de la
# maquina (RN-03 se cumple por construccion). Si algun dia se apunta a un
# proveedor de pago, la clave va AQUI en el .env real (gitignored), NUNCA en el
# codigo ni en el repositorio.
CLINIC_LLM_ENABLED=false
CLINIC_LLM_URL=http://localhost:11434/v1
CLINIC_LLM_MODEL=llama3.2:3b
CLINIC_LLM_TIMEOUT=240.0
