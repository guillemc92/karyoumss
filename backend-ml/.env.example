# backend-ml — variables de entorno (copiar a .env; el .env real no se versiona)

# DD-AUD-001 F1 (CON-02): inferencias simultáneas permitidas y espera máxima por
# un turno antes de responder 503 con Retry-After. 25 s queda por debajo de los
# 30 s con los que corta el cliente de backend-clinic.
ML_MAX_INFERENCIAS=1
ML_ESPERA_MAX_S=25

# Secreto interno de servicio (FR4). Protege GET /api/v1/inferencias/ con la
# cabecera X-Internal-Secret. Debe ser el MISMO valor que INTERNAL_SERVICE_SECRET
# en backend-clinic y backend-admin. Sin él, backend-ml arranca igual y solo ese
# endpoint responde 503 "no configurado" (FR4.3). No poner aquí un valor real.
INTERNAL_SERVICE_SECRET=
